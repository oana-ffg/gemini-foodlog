rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // FoodLog clients use the authenticated HTTP API. Firestore is a private
    // backend datastore; Admin SDK and service-account access is governed by IAM
    // and does not pass through these client rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
