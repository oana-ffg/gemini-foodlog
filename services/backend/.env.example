FOODLOG_ENVIRONMENT=local
FOODLOG_AUTH_BACKEND=local
FOODLOG_STORAGE_BACKEND=memory
FOODLOG_GCP_PROJECT_ID=gemini-foodlog-2026
FOODLOG_FIREBASE_PROJECT_ID=gemini-foodlog-2026
FOODLOG_MEDIA_BUCKET=gemini-foodlog-2026-media-163029863855
FOODLOG_IMAGE_TOPIC=projects/gemini-foodlog-2026/topics/foodlog-image-events
FOODLOG_EXPORT_TOPIC=projects/gemini-foodlog-2026/topics/foodlog-export-events
FOODLOG_ALLOWED_ORIGINS=["http://127.0.0.1:5173"]
FOODLOG_TRIAL_IMAGE_LIMIT=200
FOODLOG_PUBLIC_ACCOUNT_LIMIT=25
FOODLOG_UNLIMITED_OWNER_USER_IDS=[]
FOODLOG_LAUNCH_CONSENT_POLICY_VERSION=launch-interest-v1
FOODLOG_WAITLIST_POLICY_VERSION=capacity-waitlist-v1
FOODLOG_GROUPING_POLICY_VERSION=temporal-v1
FOODLOG_GROUPING_QUIET_SECONDS=30
FOODLOG_GROUPING_REOPEN_SECONDS=7200
FOODLOG_EXPORT_RECENT_AUTH_SECONDS=300
FOODLOG_EXPORT_REQUEST_COOLDOWN_SECONDS=3600
FOODLOG_MODEL_SPEND_LIMIT_DKK_MICROS=400000000
# Preview deployments additionally require FOODLOG_PREVIEW_SHARED_SECRET (32+ characters).
# Store it in Secret Manager; never commit it here.

# Private image-worker process settings.
FOODLOG_IMAGE_ENVIRONMENT=production
FOODLOG_IMAGE_GCP_PROJECT_ID=gemini-foodlog-2026
FOODLOG_IMAGE_GROUPING_POLICY_VERSION=temporal-v1
FOODLOG_IMAGE_GROUPING_QUIET_SECONDS=30
FOODLOG_IMAGE_GROUPING_REOPEN_SECONDS=7200
FOODLOG_IMAGE_PUBLIC_ACCOUNT_LIMIT=25
FOODLOG_IMAGE_TRIAL_IMAGE_LIMIT=200

# Private account-export worker process settings.
FOODLOG_EXPORT_WORKER_ENVIRONMENT=production
FOODLOG_EXPORT_WORKER_GCP_PROJECT_ID=gemini-foodlog-2026
FOODLOG_EXPORT_WORKER_MEDIA_BUCKET=gemini-foodlog-2026-media-163029863855
FOODLOG_EXPORT_WORKER_RAW_MAIL_BUCKET=gemini-foodlog-2026-raw-mail-163029863855
FOODLOG_EXPORT_WORKER_TRACE_BUCKET=gemini-foodlog-2026-traces-163029863855
FOODLOG_EXPORT_WORKER_EXPORT_BUCKET=gemini-foodlog-2026-exports-163029863855
FOODLOG_EXPORT_WORKER_PUBLIC_ACCOUNT_LIMIT=25
FOODLOG_EXPORT_WORKER_TRIAL_IMAGE_LIMIT=200

# Production ADK/Vertex configuration. Setting these does not invoke Gemini.
GOOGLE_CLOUD_PROJECT=gemini-foodlog-2026
GOOGLE_CLOUD_LOCATION=eu
GOOGLE_GENAI_USE_VERTEXAI=true
FOODLOG_MODEL=gemini-3.6-flash
