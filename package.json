{
  "name": "gemini-foodlog",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "build": "npm run build --workspace @foodlog/web",
    "deploy:web": "npm run build && npx --yes firebase-tools@15.28.1 deploy --only hosting --project gemini-foodlog-2026",
    "dev:web": "npm run dev --workspace @foodlog/web",
    "typecheck": "npm run typecheck --workspace @foodlog/web"
  },
  "engines": {
    "node": ">=24"
  }
}
