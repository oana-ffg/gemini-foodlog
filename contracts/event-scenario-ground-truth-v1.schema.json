{
  "$id": "https://github.com/oana-ffg/gemini-foodlog/blob/main/contracts/event-scenario-ground-truth-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "event-scenario-ground-truth-v1"
    },
    "evaluation_policy_version": {
      "const": "event-scenario-scoring-v1"
    },
    "scenario_id": {
      "pattern": "^[a-z][a-z0-9-]{2,79}$",
      "type": "string"
    },
    "title": {
      "maxLength": 160,
      "minLength": 1,
      "type": "string"
    },
    "review_status": {
      "enum": [
        "draft",
        "human_approved"
      ]
    },
    "human_review": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/humanReview"
        }
      ]
    },
    "source_kind": {
      "enum": [
        "synthetic_still",
        "synthetic_video",
        "real_capture"
      ]
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/observation"
      },
      "maxItems": 240,
      "minItems": 1,
      "type": "array"
    },
    "context": {
      "items": {
        "$ref": "#/$defs/context"
      },
      "maxItems": 40,
      "type": "array"
    },
    "expected_events": {
      "items": {
        "$ref": "#/$defs/event"
      },
      "maxItems": 20,
      "minItems": 1,
      "type": "array"
    },
    "prohibited_claims": {
      "items": {
        "$ref": "#/$defs/prohibitedClaim"
      },
      "maxItems": 40,
      "minItems": 1,
      "type": "array"
    },
    "review_notes": {
      "items": {
        "maxLength": 500,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 20,
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "evaluation_policy_version",
    "scenario_id",
    "title",
    "review_status",
    "human_review",
    "source_kind",
    "observations",
    "context",
    "expected_events",
    "prohibited_claims",
    "review_notes"
  ],
  "type": "object",
  "allOf": [
    {
      "if": {
        "properties": {
          "review_status": {
            "const": "draft"
          }
        }
      },
      "then": {
        "properties": {
          "human_review": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "review_status": {
            "const": "human_approved"
          }
        }
      },
      "then": {
        "properties": {
          "human_review": {
            "$ref": "#/$defs/humanReview"
          }
        }
      }
    }
  ],
  "$defs": {
    "component": {
      "additionalProperties": false,
      "properties": {
        "component_id": {
          "$ref": "#/$defs/identifier"
        },
        "accepted_names": {
          "$ref": "#/$defs/terms"
        },
        "required_ingredients": {
          "items": {
            "$ref": "#/$defs/ingredient"
          },
          "maxItems": 40,
          "type": "array"
        },
        "accepted_preparation_methods": {
          "items": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "component_id",
        "accepted_names",
        "required_ingredients",
        "accepted_preparation_methods"
      ],
      "type": "object"
    },
    "context": {
      "additionalProperties": false,
      "properties": {
        "context_id": {
          "$ref": "#/$defs/identifier"
        },
        "source_kind": {
          "enum": [
            "purchase",
            "household_knowledge",
            "recent_meal",
            "user_note"
          ]
        },
        "statement": {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        "available_at_offset_seconds": {
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "context_id",
        "source_kind",
        "statement",
        "available_at_offset_seconds"
      ],
      "type": "object"
    },
    "event": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "$ref": "#/$defs/identifier"
        },
        "observation_ids": {
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "maxItems": 240,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "start_offset_seconds": {
          "minimum": 0,
          "type": "number"
        },
        "end_offset_seconds": {
          "minimum": 0,
          "type": "number"
        },
        "boundary_tolerance_seconds": {
          "maximum": 3600,
          "minimum": 0,
          "type": "number"
        },
        "primary_outcome": {
          "$ref": "#/$defs/outcome"
        },
        "acceptable_alternatives": {
          "items": {
            "$ref": "#/$defs/outcome"
          },
          "maxItems": 8,
          "type": "array"
        },
        "required_evidence": {
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "maxItems": 80,
          "minItems": 1,
          "type": "array"
        },
        "question_expectation": {
          "$ref": "#/$defs/question"
        }
      },
      "required": [
        "event_id",
        "observation_ids",
        "start_offset_seconds",
        "end_offset_seconds",
        "boundary_tolerance_seconds",
        "primary_outcome",
        "acceptable_alternatives",
        "required_evidence",
        "question_expectation"
      ],
      "type": "object"
    },
    "evidence": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "$ref": "#/$defs/identifier"
        },
        "source_kind": {
          "enum": [
            "visual",
            "context"
          ]
        },
        "source_ids": {
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "maxItems": 20,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "description": {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "source_kind",
        "source_ids",
        "description"
      ],
      "type": "object"
    },
    "identifier": {
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "type": "string"
    },
    "humanReview": {
      "additionalProperties": false,
      "properties": {
        "reviewer": {
          "maxLength": 120,
          "minLength": 1,
          "type": "string"
        },
        "reviewed_at": {
          "format": "date-time",
          "type": "string"
        },
        "decision_notes": {
          "maxLength": 1000,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "reviewer",
        "reviewed_at",
        "decision_notes"
      ],
      "type": "object"
    },
    "ingredient": {
      "additionalProperties": false,
      "properties": {
        "concept_id": {
          "$ref": "#/$defs/identifier"
        },
        "accepted_terms": {
          "$ref": "#/$defs/terms"
        }
      },
      "required": [
        "concept_id",
        "accepted_terms"
      ],
      "type": "object"
    },
    "observation": {
      "additionalProperties": false,
      "properties": {
        "observation_id": {
          "$ref": "#/$defs/identifier"
        },
        "camera_id": {
          "$ref": "#/$defs/identifier"
        },
        "offset_seconds": {
          "minimum": 0,
          "type": "number"
        },
        "file_path": {
          "maxLength": 300,
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\.\\./).+$",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "observation_id",
        "camera_id",
        "offset_seconds",
        "file_path",
        "sha256"
      ],
      "type": "object"
    },
    "outcome": {
      "additionalProperties": false,
      "properties": {
        "activity_kind": {
          "enum": [
            "tentative_meal",
            "unknown_activity",
            "likely_non_cooking"
          ]
        },
        "accepted_labels": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "type": "array",
          "uniqueItems": true
        },
        "allowed_confidence": {
          "items": {
            "enum": [
              "uncertain",
              "likely",
              "confident"
            ]
          },
          "maxItems": 3,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "components": {
          "items": {
            "$ref": "#/$defs/component"
          },
          "maxItems": 20,
          "type": "array"
        }
      },
      "required": [
        "activity_kind",
        "accepted_labels",
        "allowed_confidence",
        "components"
      ],
      "type": "object"
    },
    "prohibitedClaim": {
      "additionalProperties": false,
      "properties": {
        "claim": {
          "maxLength": 300,
          "minLength": 1,
          "type": "string"
        },
        "reason": {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        "severity": {
          "enum": [
            "hard_fail",
            "deduction"
          ]
        }
      },
      "required": [
        "claim",
        "reason",
        "severity"
      ],
      "type": "object"
    },
    "question": {
      "additionalProperties": false,
      "properties": {
        "policy": {
          "enum": [
            "required",
            "allowed",
            "forbidden"
          ]
        },
        "candidate_concepts": {
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "maxItems": 8,
          "type": "array",
          "uniqueItems": true
        },
        "acceptable_impacts": {
          "items": {
            "enum": [
              "changes_meal_identity",
              "changes_food_trigger_relevance",
              "changes_reusable_household_distinction"
            ]
          },
          "maxItems": 3,
          "type": "array",
          "uniqueItems": true
        },
        "reason": {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "policy",
        "candidate_concepts",
        "acceptable_impacts",
        "reason"
      ],
      "type": "object",
      "allOf": [
        {
          "if": {
            "properties": {
              "policy": {
                "const": "required"
              }
            }
          },
          "then": {
            "properties": {
              "candidate_concepts": {
                "minItems": 2
              },
              "acceptable_impacts": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "policy": {
                "const": "forbidden"
              }
            }
          },
          "then": {
            "properties": {
              "candidate_concepts": {
                "maxItems": 0
              },
              "acceptable_impacts": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "terms": {
      "items": {
        "maxLength": 160,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 20,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    }
  }
}
